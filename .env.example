# SASI — environment template (copy to .env and fill in real values)
# NEVER commit a real .env. Secrets live only in .env / Vercel / GitHub Actions secrets.

# ---- Database (Prisma) -------------------------------------------------
# ALL environments use Supabase PostgreSQL.
#   Serverless (Vercel functions) and local dev — POOLER (IPv4-reachable):
#     postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   Direct (GitHub Actions runners / SQL editor / migrations only):
#     postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# NOTE: the direct db.<ref>.supabase.co host is IPv6-only — Vercel
# serverless functions CANNOT connect to it. Always use the pooler there.
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---- NextAuth ----------------------------------------------------------
# Production: your public URL (SASI also auto-derives this from Vercel's
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL when the var is unset).
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# ---- Supabase (https://supabase.com/dashboard/project/_/settings/api) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key — safe to expose in the browser (RLS denies it everything)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key — SERVER ONLY. Rotates at: Supabase dashboard → Settings → API
SUPABASE_SECRET_KEY=sb_secret_...

# ---- AI provider (OpenRouter — SERVER ONLY) ----------------------------
# The real AI provider behind Ask SASI, briefings, document intelligence,
# photo analysis and address refinement. Provide the key in Vercel env
# vars — never in source code, never in this file's docs, never prefixed
# with NEXT_PUBLIC_. When absent, AI features degrade honestly:
# "SASI AI is temporarily unavailable. The platform's AI provider is not
# configured." No fake answers are ever served.
OPENROUTER_API_KEY=your_server_side_key
# Optional server-side configuration (sensible defaults exist):
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# OPENROUTER_TEMPERATURE=0.4
# OPENROUTER_MAX_TOKENS=1200
# OPENROUTER_TIMEOUT_MS=45000
