# SASI — environment template (copy to .env and fill in real values)
# NEVER commit a real .env. Secrets live only in .env / Vercel / GitHub Actions secrets.

# ---- Database (Prisma) -------------------------------------------------
# Local dev (sandbox): SQLite
DATABASE_URL=file:./db/custom.db
# Production (Supabase PostgreSQL, applied by the "supabase-db" GitHub Action):
#   Direct (migrations / CI):  postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   Pooler (serverless runtime, recommended on Vercel):
#     postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1

# ---- NextAuth ----------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# ---- Supabase (https://supabase.com/dashboard/project/_/settings/api) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key — safe to expose in the browser (RLS denies it everything)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key — SERVER ONLY. Rotates at: Supabase dashboard → Settings → API
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Optional AI enrichment -------------------------------------------
# OPENROUTER_API_KEY=  # /api/sasi/geo/enrich degrades gracefully (OSM-only) when absent
