// SASI — persistence schema.
// The product is a demo-first single-route SPA; these tables back the
// "survive a reload" layer: user-created cases (reports), Ask SASI chat
// history and saved preferences, keyed by an anonymous browser session id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A case created by the user through the report wizard.
/// The full SasiCase payload is stored as JSON so the client can
/// rehydrate the exact shape it knows how to render.
model CaseRecord {
  id        String   @id @default(cuid())
  ref       String   @unique // CASE-000124
  sessionId String
  service   String
  title     String
  payload   String // full SasiCase JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, createdAt])
}

/// One Ask SASI chat message (user or assistant).
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant"
  content   String
  refs      String? // JSON array of "CASE-xxxxxx" / "INC-xxxx" strings
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

/// Per-session preferences (currently the saved location).
model Profile {
  sessionId String   @id
  location  String? // JSON { province, city, suburb }
  updatedAt DateTime @updatedAt
}
