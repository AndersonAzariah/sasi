// SASI — persistence schema.
// One source of truth for EVERY environment: local development, CI and
// production all run the SAME PostgreSQL database architecture (Supabase
// PostgreSQL). Dev connects through the IPv4 session pooler; CI applies
// the schema + RLS hardening; production (Vercel) uses the transaction
// pooler. There is no separate SQLite environment anymore.
// JSON payloads are stored as String columns — the exact shape the client
// already knows how to render, rehydrated verbatim.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A case created by the user through the report wizard.
/// The full SasiCase payload is stored as JSON so the client can
/// rehydrate the exact shape it knows how to render.
/// Refs are unique PER SESSION (not globally): each browser session
/// counts its own refs from 124, so two fresh browsers can both have
/// a CASE-000124 without hijacking each other's rows.
model CaseRecord {
  id        String   @id @default(cuid())
  ref       String // CASE-000124 (unique per session)
  sessionId String
  userId    String? // set when the case belongs to a real authenticated account
  service   String
  title     String
  payload   String // full SasiCase JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@unique([sessionId, ref])
  @@index([sessionId, createdAt])
  @@index([userId])
}

/// One Ask SASI chat message (user or assistant).
/// Task 29: rows additionally carry userId (FK) — stamped server-side
/// from the authenticated session when one exists, so a conversation is
/// explicitly owned by the account that had it, not just the browser.
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  role      String // "user" | "assistant"
  content   String
  refs      String? // JSON array of "CASE-xxxxxx" / "INC-xxxx" strings
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
}

/// Per-session preferences (currently the saved location).
/// Task 29: userId binds the profile to an account when one exists.
model Profile {
  sessionId String   @id
  userId    String?
  location  String? // JSON { province, city, suburb }
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// One evidence item added by the user (photo note / link / analysed photo).
/// Full EvidenceItem payload as JSON, deduped client-side by id.
/// Task 29: userId column + claim/verify semantics like CaseRecord.
model EvidenceRecord {
  id         String   @id @default(cuid())
  evidenceId String   @unique // client EvidenceItem.id
  sessionId  String
  userId     String?
  payload    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
}

/// One AI City briefing snapshot (append-only history, capped client-side).
/// Full CityBriefing payload as JSON so the client can re-render it exactly.
model BriefingRecord {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  risk      String // CALM | ELEVATED | STRAINED | CRITICAL (for quick ops)
  headline  String
  payload   String // full CityBriefing JSON
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
}

/// One live notification generated by real app events (report received,
/// investigation complete, action approved, briefing ready). Full
/// AppNotification payload as JSON; the read flag is a column so the
/// client can mark items read without rewriting payloads.
model NotificationRecord {
  id             String   @id @default(cuid())
  notificationId String   @unique // client AppNotification.id
  sessionId      String
  userId         String?
  read           Boolean  @default(false)
  payload        String   // full AppNotification JSON
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId, createdAt])
  @@index([userId])
}

/// A real account (phase 3): email + bcrypt password hash, JWT session via
/// NextAuth. Data rows can carry userId for server-side ownership checks.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  auditEvents     AuditEvent[]
  submissions     SubmissionRecord[]
  cases           CaseRecord[]
  chatMessages    ChatMessage[]
  profiles        Profile[]
  evidence        EvidenceRecord[]
  briefings       BriefingRecord[]
  notifications   NotificationRecord[]
  journeyRuns     JourneyRun[]
  savedItems      SavedItem[]
  reminders       Reminder[]
  documents       DocumentRecord[]
}

/// Server-stamped audit trail for real account events. Rows are written
/// by the SERVER when real events happen — never fabricated client-side.
model AuditEvent {
  id           String   @id @default(cuid())
  userId       String
  eventType    String // ACCOUNT_CREATED | EVIDENCE_REVIEWED | ...
  actor        String // SYSTEM | USER | (future agent ids)
  description  String
  caseRef      String?
  resourceType String?
  resourceId   String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

/// Phase 9 — one resident's progress through a service journey.
/// stepsDone is a JSON array of step indexes already completed.
/// The payload snapshot rehydrates the journey exactly as it was when
/// the run started. Checklist completion is NOT government completion —
/// the status column only ever reflects the resident's own progress.
model JourneyRun {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  journeyId String // e.g. "passport-apply"
  status    String   // ACTIVE | PAUSED | COMPLETED
  stepsDone String   // JSON number array, e.g. "[0,1]"
  payload   String   // journey snapshot (title, description, steps, source)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@unique([sessionId, journeyId])
  @@index([userId])
}

/// Phase 11 — a saved item in My SASI (service, journey, answer,
/// civic information). Unique per session + kind + item so saving
/// twice is idempotent.
model SavedItem {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  kind      String // "service" | "journey" | "answer" | "info"
  itemId    String // slug or ref (e.g. "passport", "CASE-000124")
  payload   String   // what to render when the resident returns
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@unique([sessionId, kind, itemId])
  @@index([userId])
}

/// Phase 11 — a resident-created reminder. Always labelled as a SASI
/// reminder in the UI; NEVER presented as an official government
/// communication (Phase 19 rule).
model Reminder {
  id        String    @id @default(cuid())
  sessionId String
  userId    String?
  title     String
  note      String?
  dueAt     DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId, done])
  @@index([userId])
}

/// Phase 15 — a civic document the resident uploaded. Only metadata and
/// the AI analysis (summary, key information, dates, required actions)
/// are stored — never the raw file bytes. Rows are deleted immediately
/// and permanently when the resident deletes the document.
model DocumentRecord {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  name      String
  mimeType  String
  sizeBytes Int
  summary   String?
  keyInfo   String? // JSON { importantInfo[], dates[], actions[] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId, createdAt])
  @@index([userId])
}

/// A PREPARATION record for institutional submission. No adapter exists
/// today, so status is always NOT_CONNECTED and externalReference is
/// always null — the row proves the request existed, nothing more.
model SubmissionRecord {
  id                String   @id @default(cuid())
  userId            String
  caseRef           String
  institutionKey    String
  institutionName   String?
  status            String // NOT_CONNECTED (only status possible today)
  externalReference String?
  requestPayload    String
  resultPayload     String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
