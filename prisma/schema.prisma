// SASI — persistence schema.
// The product is a demo-first single-route SPA; these tables back the
// "survive a reload" layer: user-created cases (reports), Ask SASI chat
// history and saved preferences, keyed by an anonymous browser session id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A case created by the user through the report wizard.
/// The full SasiCase payload is stored as JSON so the client can
/// rehydrate the exact shape it knows how to render.
/// Refs are unique PER SESSION (not globally): each browser session
/// counts its own refs from 124, so two fresh browsers can both have
/// a CASE-000124 without hijacking each other's rows.
model CaseRecord {
  id        String   @id @default(cuid())
  ref       String // CASE-000124 (unique per session)
  sessionId String
  service   String
  title     String
  payload   String // full SasiCase JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, ref])
  @@index([sessionId, createdAt])
}

/// One Ask SASI chat message (user or assistant).
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant"
  content   String
  refs      String? // JSON array of "CASE-xxxxxx" / "INC-xxxx" strings
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

/// Per-session preferences (currently the saved location).
model Profile {
  sessionId String   @id
  location  String? // JSON { province, city, suburb }
  updatedAt DateTime @updatedAt
}

/// One evidence item added by the user (photo note / link / analysed photo).
/// Full EvidenceItem payload as JSON, deduped client-side by id.
model EvidenceRecord {
  id         String   @id @default(cuid())
  evidenceId String   @unique // client EvidenceItem.id
  sessionId  String
  payload    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sessionId])
}

/// One AI City briefing snapshot (append-only history, capped client-side).
/// Full CityBriefing payload as JSON so the client can re-render it exactly.
model BriefingRecord {
  id        String   @id @default(cuid())
  sessionId String
  risk      String // CALM | ELEVATED | STRAINED | CRITICAL (for quick ops)
  headline  String
  payload   String // full CityBriefing JSON
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

/// One live notification generated by real app events (report received,
/// investigation complete, action approved, briefing ready). Full
/// AppNotification payload as JSON; the read flag is a column so the
/// client can mark items read without rewriting payloads.
model NotificationRecord {
  id             String   @id @default(cuid())
  notificationId String   @unique // client AppNotification.id
  sessionId      String
  read           Boolean  @default(false)
  payload        String   // full AppNotification JSON
  createdAt      DateTime @default(now())

  @@index([sessionId, createdAt])
}
